import random
import string
import os

def clear_screen():
    # Pydroid aur PC dono pe chale ga
    os.system('cls' if os.name == 'nt' else 'clear')
    # Agar upar wala na chale to simple tareeqa:
    # print("\n" * 50)

print("Password Generator Pro")
print("Note: Enter numbers only\n")

while True:
    # Length ka input with validation
    while True:
        length = input("Enter password length: ")
        try:
            length = int(length)
            if length < 4:
                print("Error: Minimum length is 4.\n")
            elif length > 50:
                print("Error: Maximum length is 50.\n")
            else:
                break
        except ValueError:
            print("Error: Please enter  number only.\n")
    
    # Special characters ka option - Y/N VALIDATION
    while True:
        special = input("Include special characters? (y/n): ").lower()
        if special == 'y' or special == 'n':
            break
        else:
            print("Error: Please enter 'y' or 'n' only.\n")
    
    # Password generate karna - GUARANTEED LOGIC
    if special == 'y':
        special_chars = "!@#$%^&*"
        password = [random.choice(special_chars)]
        all_chars = string.ascii_letters + string.digits + special_chars
        password += [random.choice(all_chars) for i in range(length - 1)]
        random.shuffle(password)
        password = ''.join(password)
    else:
        all_chars = string.ascii_letters + string.digits
        password = ''.join(random.choice(all_chars) for i in range(length))
    
    print(f"\nGenerated Password: {password}")
    print(f"Length: {length} characters")
    if special == 'y':
        print("Special characters: Included")
    else:
        print("Special characters: Not included")
    
    # Continue karna hai ya nahi
    while True:
        choice = input("\nGenerate another password? (y/n): ").lower()
        if choice == 'y':
            clear_screen()  
            print("Password Generator Pro")
            print("Note: Enter numbers only\n")
            break
        elif choice == 'n':
            print("\nPassword Generator closed. Thank you!")
            exit()
        else:
            print("Error: Please enter 'y' or 'n' only."
