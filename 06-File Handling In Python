import os

FILE_NAME = "todo_list.txt"

def load_tasks():
    """File se tasks load karta hai"""
    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r") as file:
            tasks = [line.strip() for line in file.readlines()]
        return tasks
    return []

def save_tasks(tasks):
    """Tasks ko file mein save karta hai"""
    with open(FILE_NAME, "w") as file:
        for task in tasks:
            file.write(task + "\n")

def show_menu():
    print("\n" + "="*40)
    print("TO-DO LIST MANAGER")
    print("="*40)
    print("1. Add Task")
    print("2. View All Tasks")
    print("3. Delete Task")
    print("4. Exit")
    print("="*40)

def view_tasks(tasks):
    if not tasks:
        print("\nNo tasks found. List is empty!")
        return False
    else:
        print("\nYour Tasks:")
        for i, task in enumerate(tasks, 1):
            print(f"{i}. {task}")
        return True

def main():
    tasks = load_tasks()
    
    while True:
        show_menu()
        choice = input("Enter your choice (1-4): ").strip()
        
        if choice == '1':
            task = input("\nEnter new task: ").strip()
            if task:
                tasks.append(task)
                save_tasks(tasks)
                print(f"Task added: {task}")
            else:
                print("Error: Task cannot be empty")
                
        elif choice == '2':
            view_tasks(tasks)
            
        elif choice == '3':
            # DELETE WALA FIX - LOOP ADD KIYA
            if view_tasks(tasks):
                while True:
                    try:
                        user_input = input("\nEnter task number to delete (or 'c' to cancel): ").strip()
                        
                        if user_input.lower() == 'c':
                            print("Delete cancelled")
                            break
                            
                        task_num = int(user_input)
                        if 1 <= task_num <= len(tasks):
                            removed = tasks.pop(task_num - 1)
                            save_tasks(tasks)
                            print(f"Task deleted: {removed}")
                            break
                        else:
                            print(f"Error: Please enter a number between 1 and {len(tasks)}")
                    except ValueError:
                        print("Error: Please enter a valid number or 'c' to cancel")
                    
        elif choice == '4':
            print("\nGoodbye! Your tasks are saved.")
            break
            
        else:
            print("Error: Please enter 1, 2, 3, or 4")

if __name__ == "__main__":
    main()
