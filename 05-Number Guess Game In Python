import random

print("Number Guessing Game")
print("I have selected a number between 1 and 100\n")

while True:
    secret_number = random.randint(1, 100)
    attempts = 0
    
    while True:
        try:
            guess = int(input("Enter your guess: "))
            
            if guess < 1 or guess > 100:
                print("Error: Please enter a number between 1 and 100 only\n")
                continue
            
            attempts += 1
            
            if guess < secret_number:
                print("Too low! Try a higher number")
            elif guess > secret_number:
                print("Too high! Try a lower number")
            else:
                print(f"\nCorrect! The number was {secret_number}")
                print(f"You guessed it in {attempts} attempts")
                break
                
        except ValueError:
            print("Error: Please enter a valid number only\n")
    
    # PLAY AGAIN - NO FAKE CLEAR
    while True:
        play_again = input("\nPlay again? (y/n): ").lower().strip()
        if play_again == 'y':
            print("\n" + "="*40)  # SIRF LINE SEPARATE KAR DI
            print("NEW GAME STARTED")
            print("="*40)
            print("I have selected a new number between 1 and 100\n")
            break
        elif play_again == 'n':
            print("\nGame ended. Thanks for playing!")
            exit()
        else:
            print("Error: Please enter 'y' for yes or 'n' for no")
