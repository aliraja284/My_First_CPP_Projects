#include <iostream>
#include <cstdlib> 
#include <ctime> 
#include <limits>
using namespace std;

void clearScreen() {
    system("clear"); // CxxDroid/Termux/Linux ke liye sahi tareeka
    // PC pe hota to system("cls"); likhte
}

int main() {
    string letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    string symbols = "!@#$%^&*";
    int length, choice;
    char symbolChoice;
    
    srand(time(0));
    
    do {
        clearScreen(); // Ab asli screen clear hogi
        cout << "=== Pro Password Generator ===" << endl;
        
        cout << "Enter password length: ";
        while(!(cin >> length) || length <= 0){
            cout << "Error! Enter a valid number greater than 0: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        
        cout << "Include special symbols!@#$%^&*? y/n: ";
        while(!(cin >> symbolChoice) || (symbolChoice!='y' && symbolChoice!='Y' && symbolChoice!='n' && symbolChoice!='N')){
            cout << "Error! Only y or n allowed: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        
        string finalCharacters = letters;
        string password = "";
        
        if(symbolChoice == 'y' || symbolChoice == 'Y'){
            finalCharacters = letters + symbols;
            int randomIndex = rand() % symbols.length();
            password = password + symbols[randomIndex];
            for(int i = 1; i < length; i++){
                int randomIndex = rand() % finalCharacters.length();
                password = password + finalCharacters[randomIndex];
            }
            for(int i = 0; i < password.length(); i++){
                int j = rand() % password.length();
                swap(password[i], password[j]);
            }
        } else {
            for(int i = 0; i < length; i++){
                int randomIndex = rand() % finalCharacters.length();
                password = password + finalCharacters[randomIndex];
            }
        }
        
        cout << "\nYour Strong Password: " << password << endl;
        cout << "Keep it safe!" << endl;
        
        cout << "\nGenerate another password? Press 1 for yes, 2 for exit: ";
        while(!(cin >> choice) || (choice!=1 && choice!=2)){
            cout << "Error! Only 1 or 2 allowed: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        
    } while(choice == 1);
    
    clearScreen();
    cout << "Password Generator Closed. Goodbye!" << endl;
    return 0;
}
